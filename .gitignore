# Local secrets — never commit real API keys. Copy config/local.example.php
# to config/local.php and fill in your own values there.
config/local.php

node_modules/
test-results/
playwright-report/

# Composer's own autoloader output (this project has zero real dependencies
# — composer.json exists only so hosts auto-detect PHP — so there's nothing
# here worth committing; includes/vendor/phpqrcode is unrelated and stays
# committed as-is).
/vendor/

# QR codes are regenerated automatically (see admin/qr_all.php's backfill
# logic) from trees.id — not worth tracking as binary churn per tree.
public/assets/uploads/qr/

# ML training pipeline: downloaded third-party photos, labels and trained model files
# are large/regenerable (see ml/README steps 1-3), so they are not committed.
ml/data/
ml/models/

# Photos uploaded through the admin forms while testing locally
public/assets/uploads/species/

# Personal notes that may contain pasted keys
issu.md

# Local-only AI conversation viewer (not part of the deployed project)
ml/live_viewer.py
ml/viewer.html
ml/__pycache__/
