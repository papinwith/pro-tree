<VirtualHost *:__PORT__>
	ServerAdmin webmaster@localhost
	DocumentRoot /var/www/html

	ErrorLog ${APACHE_LOG_DIR}/error.log
	CustomLog ${APACHE_LOG_DIR}/access.log combined

	# Railway (and any other TLS-terminating reverse proxy) forwards
	# requests to this container as plain HTTP on its internal port.
	# Apache's own automatic redirects -- e.g. mod_dir adding the missing
	# trailing slash for a bare /admin or /public request -- normally
	# build the Location header from Apache's OWN idea of scheme/host/port
	# ("http://host:__PORT__/admin/"), which isn't reachable from outside
	# the container. Neither `Header edit Location` (mod_headers doesn't
	# rewrite it here) nor a relative RewriteRule target (mod_rewrite
	# re-qualifies it back to an absolute http://host:port URL regardless)
	# actually fixes this -- confirmed by testing both live against a
	# running deployment. Handling just these two entry points explicitly,
	# building the Location ourselves from the proxy's forwarded scheme
	# and the original Host header, is what actually works.
	# Let browsers reuse static files between page switches instead of asking the
	# server about each one again (every request costs a round trip), and compress
	# text responses. Short lifetimes because CSS/JS have no version in their URL;
	# QR images keep a fixed name per tree, so they are never cached. Guarded with
	# IfModule so a missing module can never stop Apache from starting.
	<IfModule mod_expires.c>
		ExpiresActive On
		ExpiresByType text/css "access plus 10 minutes"
		ExpiresByType application/javascript "access plus 10 minutes"
		ExpiresByType text/javascript "access plus 10 minutes"
		ExpiresByType image/png "access plus 1 hour"
		ExpiresByType image/jpeg "access plus 1 hour"
		ExpiresByType image/webp "access plus 1 hour"
		ExpiresByType image/gif "access plus 1 hour"
		<LocationMatch "^/public/assets/uploads/qr/">
			ExpiresActive Off
		</LocationMatch>
	</IfModule>
	<IfModule mod_deflate.c>
		AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
	</IfModule>

	# The whole repo is copied into the web root (so /admin and /public both
	# work), which also made everything else downloadable or executable by URL:
	# docs/install.postgres.sql (schema + seed data + password hashes),
	# Dockerfile, package.json, README, the include files (where a direct request
	# printed a PHP fatal error with server paths). None of it is meant to be
	# requested by a browser — PHP `require`s are not affected by these rules.
	<DirectoryMatch "^/var/www/html/(config|includes|docs|tests|docker|node_modules|\.git|\.github|\.claude|\.railway)(/|$)">
		Require all denied
	</DirectoryMatch>
	<FilesMatch "^(\..*|_.*\.php|Dockerfile|railway\.(json|toml)|package(-lock)?\.json|.*\.(sql|md|sh|lock|log|bak|ini|example|yml|yaml))$">
		Require all denied
	</FilesMatch>

	DirectorySlash Off
	RewriteEngine On
	RewriteCond %{HTTP:X-Forwarded-Proto} =https
	RewriteRule ^/admin$ https://%{HTTP_HOST}/admin/ [R=301,L]
	RewriteCond %{HTTP:X-Forwarded-Proto} =https
	RewriteRule ^/public$ https://%{HTTP_HOST}/public/ [R=301,L]
	RewriteRule ^/admin$ http://%{HTTP_HOST}/admin/ [R=301,L]
	RewriteRule ^/public$ http://%{HTTP_HOST}/public/ [R=301,L]
</VirtualHost>
